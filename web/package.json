{
  "name": "sokobot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun svelte-check --tsconfig ./tsconfig.json && bunx --bun vite build",
    "start": "bun server/main.ts",
    "typecheck": "bunx --bun svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src server vite.config.ts",
    "format:check": "prettier --check src server vite.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@observablehq/plot": "^0.6.17",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "hono": "^4.13.13",
    "@sokobot/core": "workspace:*"
  }
}
